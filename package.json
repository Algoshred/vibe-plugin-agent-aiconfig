{
  "name": "@vibecontrols/vibe-plugin-bridle",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "description": "Cross-harness configuration management via Bridle",
  "engines": { "bun": ">=1.3.0" },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external elysia",
    "dev": "tsc --watch",
    "type:check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prebuild": "bun run clean"
  },
  "dependencies": { "elysia": "^1.4.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": { "@vibecontrols/agent": ">=2.0.0" },
  "peerDependenciesMeta": { "@vibecontrols/agent": { "optional": true } }
}
